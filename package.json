{
  "name": "aieditor",
  "version": "2.0.0",
  "description": "A modular, extensible rich text editor with AI-assisted editing.",
  "author": "yangfuhai",
  "license": "LGPL-2.1-only",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "style": "./dist/style.css",
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "MIGRATION.md",
    "README.md",
    "assets/image/aieditor.png"
  ],
  "sideEffects": true,
  "keywords": [
    "editor",
    "rich-text-editor",
    "tiptap",
    "ai",
    "ai-editor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aieditor-team/aieditor.git"
  },
  "bugs": {
    "url": "https://github.com/aieditor-team/aieditor/issues"
  },
  "homepage": "https://github.com/aieditor-team/aieditor#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && vite build && node scripts/finalize-build.mjs",
    "build:demo": "npm run typecheck && vite build --config vite.demo.config.ts",
    "preview": "vite preview --config vite.demo.config.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint:package": "publint",
    "lint:types": "attw --pack . --entrypoints .",
    "verify:package": "node scripts/verify-package.mjs",
    "audit:runtime": "npm audit --omit=dev --audit-level=high",
    "ci": "npm run test:run && npm run build && npm run build:demo && npm run lint:package && npm run lint:types && npm run verify:package && npm run audit:runtime",
    "prepack": "npm run build && npm run lint:package && npm run verify:package",
    "prepublishOnly": "npm run test:run"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@microsoft/api-extractor": "^7.59.0",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "publint": "^0.3.24",
    "typescript": "~7.0.2",
    "unplugin-dts": "^1.1.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@tiptap/core": "^3.31.2",
    "@tiptap/extension-blockquote": "^3.31.2",
    "@tiptap/extension-bold": "^3.31.2",
    "@tiptap/extension-bubble-menu": "^3.31.2",
    "@tiptap/extension-code": "^3.31.2",
    "@tiptap/extension-code-block-lowlight": "^3.31.2",
    "@tiptap/extension-details": "^3.31.2",
    "@tiptap/extension-document": "^3.31.2",
    "@tiptap/extension-emoji": "^3.31.2",
    "@tiptap/extension-file-handler": "^3.31.2",
    "@tiptap/extension-floating-menu": "^3.31.2",
    "@tiptap/extension-hard-break": "^3.31.2",
    "@tiptap/extension-heading": "^3.31.2",
    "@tiptap/extension-highlight": "^3.31.2",
    "@tiptap/extension-horizontal-rule": "^3.31.2",
    "@tiptap/extension-image": "^3.31.2",
    "@tiptap/extension-italic": "^3.31.2",
    "@tiptap/extension-link": "^3.31.2",
    "@tiptap/extension-list": "^3.31.2",
    "@tiptap/extension-mathematics": "^3.31.2",
    "@tiptap/extension-mention": "^3.31.2",
    "@tiptap/extension-paragraph": "^3.31.2",
    "@tiptap/extension-placeholder": "^3.31.2",
    "@tiptap/extension-strike": "^3.31.2",
    "@tiptap/extension-subscript": "^3.31.2",
    "@tiptap/extension-superscript": "^3.31.2",
    "@tiptap/extension-table": "^3.31.2",
    "@tiptap/extension-table-of-contents": "^3.31.2",
    "@tiptap/extension-task-item": "^3.31.2",
    "@tiptap/extension-task-list": "^3.31.2",
    "@tiptap/extension-text": "^3.31.2",
    "@tiptap/extension-text-align": "^3.31.2",
    "@tiptap/extension-text-style": "^3.31.2",
    "@tiptap/extension-twitch": "^3.31.2",
    "@tiptap/extension-underline": "^3.31.2",
    "@tiptap/extension-unique-id": "^3.31.2",
    "@tiptap/extension-youtube": "^3.31.2",
    "@tiptap/extensions": "^3.31.2",
    "@tiptap/pm": "^3.31.2",
    "@tiptap/suggestion": "^3.31.2",
    "dompurify": "^3.4.14",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.4",
    "lowlight": "^3.3.0",
    "lucide": "^1.34.0",
    "marked": "^18.0.11",
    "openai": "^7.8.0"
  }
}
